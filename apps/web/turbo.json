{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["build/**", ".svelte-kit/output/**"]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "typecheck"]
    }
  }
}
