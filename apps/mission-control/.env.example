NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://dash:dash@127.0.0.1:54329/mission_control
DEV_WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-placeholder-secret-not-for-deploys
# The GitHub App, all six or none. Without them, Connect GitHub is off; production needs them.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# The AI briefing's OpenAI API key. Unset, the briefing is off; production boots without it.
# OPENAI_API_KEY=
# The OpenAI model for the briefing; it can change without a release.
# BRIEFING_MODEL=gpt-6-luna
# USD per million input tokens. OpenAI has no pricing API: these are Standard-tier, short-context estimates from its pricing page (checked 2026-11-27).
# BRIEFING_INPUT_USD_PER_MTOK=0.10
# USD per million cached input tokens, same tier and context as the input price.
# BRIEFING_CACHED_INPUT_USD_PER_MTOK=0.01
# USD per million output tokens, same tier and context as the input price.
# BRIEFING_OUTPUT_USD_PER_MTOK=0.50
# The briefing's monthly budget in USD.
# BRIEFING_MONTHLY_BUDGET_USD=100
# The per-run output token ceiling (max_output_tokens, includes reasoning tokens).
# BRIEFING_MAX_OUTPUT_TOKENS=4000
