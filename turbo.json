{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "eslint.config.js",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "//#typecheck:root"]
    },
    "lint": {
      "dependsOn": ["//#lint:root"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "//#lint:root": {},
    "//#typecheck:root": {},
    "test:e2e": {
      "dependsOn": ["build"],
      "passThroughEnv": ["CI"]
    }
  }
}
