{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "//#typecheck:root"]
    },
    "lint": {
      "dependsOn": ["//#lint:root"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "//#lint:root": {},
    "//#typecheck:root": {}
  }
}
