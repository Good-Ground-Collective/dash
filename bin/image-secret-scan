#!/usr/bin/env bash
# Fails if an image holds a credential that its base image doesn't.
# Usage: bin/image-secret-scan <image> <base-image> [ENV_VAR_NAME ...]
#
# Checks the image's history and config, then its exported filesystem, for
# credential markers and for the value of each named variable (never printed).
# Filesystem hits are compared to the base image by path and checksum, so the
# npm and yarn the node image ships don't count. Library code also mentions
# markers (`npm_config_user_agent`, a PEM header constant), so a file the image
# adds fails only if it holds a credential-shaped string, or is a .npmrc or .env.
set -euo pipefail

image=${1:?usage: bin/image-secret-scan <image> <base-image> [ENV_VAR_NAME ...]}
base=${2:?usage: bin/image-secret-scan <image> <base-image> [ENV_VAR_NAME ...]}
shift 2

work=$(mktemp -d)
containers=()
cleanup() {
  for id in "${containers[@]}"; do docker rm -f "$id" >/dev/null 2>&1 || true; done
  rm -rf "$work"
}
trap cleanup EXIT

printf '%s\n' ghp_ gho_ ghs_ ghu_ ghr_ github_pat_ tskey- npm_ _authToken 'BEGIN PRIVATE KEY' 'PRIVATE KEY-----' >"$work/markers"
printf '%s\n' \
  '(ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{36}' \
  'github_pat_[A-Za-z0-9_]{50,}' \
  'tskey-[a-z]+-[A-Za-z0-9]{8,}' \
  'npm_[A-Za-z0-9]{36}' \
  '_authToken[[:space:]]*=[[:space:]]*[^$[:space:]]' \
  '-----BEGIN [A-Z ]*PRIVATE KEY-----[[:space:]]*[A-Za-z0-9+/=]{40}' >"$work/shapes"
: >"$work/values"
for name in "$@"; do
  if [[ -z ${!name:-} ]]; then
    echo "error: $name is not set" >&2
    exit 2
  fi
  printf '%s\n' "${!name}" >>"$work/values"
done

failed=0
fail() {
  echo "FAIL: $*" >&2
  failed=1
}

docker history --no-trunc --format '{{.CreatedBy}}' "$image" >"$work/history"
docker image inspect --format '{{json .Config}}' "$image" >"$work/config"
# Runs grep, but exits the scan when grep errors (exit 2) rather than letting
# the error pass for "no match" (exit 1). Returns grep's 0 or 1.
grep_checked() {
  local status=0
  grep "$@" || status=$?
  if ((status > 1)); then
    echo "error: grep failed while scanning" >&2
    exit 2
  fi
  return "$status"
}

for part in history config; do
  if grep_checked -a -q -F -f "$work/markers" "$work/$part"; then
    fail "$part matches a credential marker"
  fi
  if [[ -s $work/values ]] && grep_checked -a -q -F -f "$work/values" "$work/$part"; then
    fail "$part contains a named variable's value"
  fi
done

# Prints "<sha256> <path>" for each file in the image's filesystem that matches a marker or is a .npmrc or .env file.
suspects() {
  local ref=$1 root=$2 id
  id=$(docker create --platform linux/amd64 "$ref")
  containers+=("$id")
  mkdir -p "$root"
  docker export --output "$root.tar" "$id"
  tar -x -f "$root.tar" -C "$root"
  rm "$root.tar"
  if [[ ! -x $root/usr/local/bin/node ]]; then
    echo "error: the export of $ref looks incomplete" >&2
    exit 2
  fi
  {
    grep_checked -r -a -l -F -f "$work/markers" "$root" || true
    find "$root" -type f \( -name '.npmrc' -o -name '.env' -o -name '.env.*' \)
  } | sort -u | while read -r file; do
    printf '%s %s\n' "$(shasum -a 256 "$file" | cut -d' ' -f1)" "${file#"$root"}"
  done | sort
}

suspects "$image" "$work/image" >"$work/image-suspects"
suspects "$base" "$work/base" >"$work/base-suspects"
comm -23 "$work/image-suspects" "$work/base-suspects" | cut -d' ' -f2- >"$work/added"
while read -r file; do
  name=${file##*/}
  if [[ $name == .npmrc || $name == .env || $name == .env.* ]]; then
    fail "$file is a .npmrc or .env file"
  elif grep_checked -a -q -E -f "$work/shapes" "$work/image$file"; then
    fail "$file holds a credential-shaped string"
  else
    echo "marker only: $file ($(grep -a -o -F -f "$work/markers" "$work/image$file" | sort -u | paste -sd, -))"
  fi
done <"$work/added"
if [[ -s $work/values ]]; then
  if grep_checked -r -a -q -F -f "$work/values" "$work/image"; then
    fail "the filesystem contains a named variable's value"
  fi
fi

if [[ $failed -ne 0 ]]; then
  exit 1
fi
echo "clean: $image ($(wc -l <"$work/base-suspects" | tr -d ' ') base-image marker files, $(wc -l <"$work/added" | tr -d ' ') added marker files with no credential shape, $(wc -l <"$work/values" | tr -d ' ') secret values absent)"
