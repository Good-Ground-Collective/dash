#!/usr/bin/env bash
# Proves bin/image-secret-scan still catches leaks: a canary image with a planted
# token, .npmrc and secret value must fail every check, and a harmless image
# built on the same base must pass. The fake credentials are generated here, so
# none is committed.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
base=$(sed -n 's/^ARG NODE_IMAGE=//p' apps/web/Dockerfile)
work=$(mktemp -d)
trap 'rm -rf "$work"; docker rmi -f dash-scan-canary dash-scan-clean >/dev/null 2>&1 || true' EXIT

token=ghp_$(printf 'a%.0s' {1..36})
export CANARY_SECRET=canary-$RANDOM-$RANDOM-value

cat >"$work/Dockerfile.canary" <<DOCKERFILE
FROM $base
RUN echo "const t = '$token';" > /srv-token.js
RUN printf '%s\n' '//npm.pkg.github.com/:_authToken=abc' > /root/.npmrc
RUN echo '$CANARY_SECRET' > /srv-config
DOCKERFILE
echo 'const agent = process.env.npm_config_user_agent;' >"$work/harmless.js"
cat >"$work/Dockerfile.clean" <<DOCKERFILE
FROM $base
COPY harmless.js /srv-harmless.js
DOCKERFILE

docker build --quiet --platform linux/amd64 -f "$work/Dockerfile.canary" -t dash-scan-canary "$work" >/dev/null
docker build --quiet --platform linux/amd64 -f "$work/Dockerfile.clean" -t dash-scan-clean "$work" >/dev/null

status=0
bin/image-secret-scan dash-scan-canary "$base" CANARY_SECRET >"$work/out" 2>&1 || status=$?
failed=0
expect() {
  if ! grep -q -F "$1" "$work/out"; then
    echo "missing: $1" >&2
    failed=1
  fi
}
expect 'FAIL: history matches a credential marker'
expect 'FAIL: history contains a named variable'
expect 'FAIL: /srv-token.js holds a credential-shaped string'
expect 'FAIL: /root/.npmrc is a .npmrc or .env file'
expect "FAIL: the filesystem contains a named variable's value"
if ((status != 1)); then
  echo "canary scan exited $status, expected 1" >&2
  failed=1
fi

if ! bin/image-secret-scan dash-scan-clean "$base" CANARY_SECRET >"$work/clean" 2>&1; then
  echo "the harmless image failed the scan:" >&2
  cat "$work/clean" >&2
  failed=1
fi

if ((failed)); then
  cat "$work/out" >&2
  exit 1
fi
echo "ok: the canary failed every check and the harmless image passed"
