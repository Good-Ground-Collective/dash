#!/usr/bin/env bash
# Builds an app's linux/amd64 image, proves it holds no credentials, and with
# --push publishes it to GHCR tagged with the commit SHA, plus each --tag (a
# release version such as v1.2.0), for `kamal deploy --skip-push --version <tag>`.
# The image carries APP_VERSION (the first --tag, or `dev` without one) and
# APP_COMMIT (the commit SHA) as runtime environment, for the web app's
# account menu and Mission Control's /healthz.
# Run from anywhere in the repository.
# Usage: bin/image <web|mission-control> [--push] [--tag <tag>]...
# Pushing reads GHCR_PUSH_USERNAME and GHCR_PUSH_TOKEN (write:packages), and
# falls back to the gh CLI's login and token.
# IMAGE_CACHE_FROM and IMAGE_CACHE_TO, when set, pass through to buildx as
# --cache-from and --cache-to (CI uses type=gha).
set -euo pipefail

usage='usage: bin/image <web|mission-control> [--push] [--tag <tag>]...'
app=${1:-}
case $app in
  web | mission-control) shift ;;
  *) echo "$usage" >&2 && exit 2 ;;
esac
push=
extra_tags=()
while (($#)); do
  if [[ $1 == --push ]]; then
    push=--push
    shift
  elif [[ $1 == --tag && ${2:-} =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]]; then
    extra_tags+=("$2")
    shift 2
  else
    echo "$usage" >&2
    exit 2
  fi
done
if [[ -z $push && ${#extra_tags[@]} -gt 0 ]]; then
  echo "--tag needs --push: $usage" >&2
  exit 2
fi

root=$(git rev-parse --show-toplevel)
cd "$root"
source bin/lib/infra-env.sh

if [[ -n $push && -n $(git status --porcelain) ]]; then
  echo "refusing to push from a dirty tree: the tag must name the commit it was built from" >&2
  exit 1
fi

dockerfile=apps/$app/Dockerfile
repository=ghcr.io/good-ground-collective/dash-$app
version=$(git rev-parse HEAD)
app_version=${extra_tags[0]:-dev}
base=$(sed -n 's/^ARG NODE_IMAGE=//p' "$dockerfile")

if [[ -z ${NODE_AUTH_TOKEN:-} ]]; then
  NODE_AUTH_TOKEN=$(gh auth token)
fi
export NODE_AUTH_TOKEN

cache=()
[[ -z ${IMAGE_CACHE_FROM:-} ]] || cache+=(--cache-from "$IMAGE_CACHE_FROM")
[[ -z ${IMAGE_CACHE_TO:-} ]] || cache+=(--cache-to "$IMAGE_CACHE_TO")

docker buildx build --platform linux/amd64 --load ${cache[@]+"${cache[@]}"} \
  --secret id=NODE_AUTH_TOKEN,env=NODE_AUTH_TOKEN \
  --build-arg APP_VERSION="$app_version" --build-arg APP_COMMIT="$version" \
  --file "$dockerfile" --tag "$repository:$version" .

# Load every secret in infra.env, not only the app's, so the scan proves none of them leaked.
load_infra_env '^[A-Za-z_][A-Za-z0-9_]*$'
secrets=(NODE_AUTH_TOKEN)
for name in KAMAL_REGISTRY_PASSWORD GHCR_PUSH_TOKEN DASH_BETTER_AUTH_SECRET DASH_DATABASE_URL DASH_GITHUB_APP_CLIENT_SECRET DASH_GITHUB_APP_PRIVATE_KEY DASH_GITHUB_WEBHOOK_SECRET DASH_OPENAI_API_KEY ${infra_env_names[@]+"${infra_env_names[@]}"}; do
  if [[ -n ${!name:-} ]]; then
    secrets+=("$name")
  fi
done
names=()
while IFS= read -r name; do names+=("$name"); done < <(printf '%s\n' "${secrets[@]}" | sort -u)
bin/image-secret-scan "$repository:$version" "$base" "${names[@]}"

if [[ $push == --push ]]; then
  # A throwaway Docker config, so the push credential never reaches a keychain or ~/.docker.
  config=$(mktemp -d)
  trap 'rm -rf "$config"' EXIT
  username=${GHCR_PUSH_USERNAME:-$(gh api user --jq .login)}
  auth=$(printf '%s:%s' "$username" "${GHCR_PUSH_TOKEN:-$(gh auth token)}" | base64 | tr -d '\n')
  printf '{"auths":{"ghcr.io":{"auth":"%s"}}}' "$auth" >"$config/config.json"

  for tag in "$version" ${extra_tags[@]+"${extra_tags[@]}"}; do
    [[ $tag == "$version" ]] || docker tag "$repository:$version" "$repository:$tag"
    DOCKER_CONFIG=$config docker push --quiet "$repository:$tag"
    echo "pushed $repository:$tag"
  done
fi
