#!/usr/bin/env bash
# Builds an app's linux/amd64 image, proves it holds no credentials, and with
# --push publishes it to GHCR tagged with the commit SHA for `kamal deploy
# --skip-push --version <sha>`. Run from anywhere in the repository.
# Usage: bin/image <web|mission-control> [--push]
set -euo pipefail

usage='usage: bin/image <web|mission-control> [--push]'
app=${1:-}
push=${2:-}
case $app in
  web | mission-control) ;;
  *) echo "$usage" >&2 && exit 2 ;;
esac
if [[ -n $push && $push != --push ]] || (($# > 2)); then
  echo "$usage" >&2
  exit 2
fi

root=$(git rev-parse --show-toplevel)
cd "$root"
source bin/lib/infra-env.sh

if [[ -n $push && -n $(git status --porcelain) ]]; then
  echo "refusing to push from a dirty tree: the tag must name the commit it was built from" >&2
  exit 1
fi

dockerfile=apps/$app/Dockerfile
repository=ghcr.io/good-ground-collective/dash-$app
version=$(git rev-parse HEAD)
base=$(sed -n 's/^ARG NODE_IMAGE=//p' "$dockerfile")

if [[ -z ${NODE_AUTH_TOKEN:-} ]]; then
  NODE_AUTH_TOKEN=$(gh auth token)
fi
export NODE_AUTH_TOKEN

docker buildx build --platform linux/amd64 --load \
  --secret id=NODE_AUTH_TOKEN,env=NODE_AUTH_TOKEN \
  --file "$dockerfile" --tag "$repository:$version" .

# Load every secret in infra.env, not only the app's, so the scan proves none of them leaked.
load_infra_env '^[A-Za-z_][A-Za-z0-9_]*$'
secrets=(NODE_AUTH_TOKEN)
for name in KAMAL_REGISTRY_PASSWORD ${infra_env_names[@]+"${infra_env_names[@]}"}; do
  if [[ -n ${!name:-} ]]; then
    secrets+=("$name")
  fi
done
bin/image-secret-scan "$repository:$version" "$base" $(printf '%s\n' "${secrets[@]}" | sort -u)

if [[ $push == --push ]]; then
  # A throwaway Docker config, so the push credential never reaches a keychain or ~/.docker.
  config=$(mktemp -d)
  trap 'rm -rf "$config"' EXIT
  username=${KAMAL_REGISTRY_USERNAME:-$(gh api user --jq .login)}
  auth=$(printf '%s:%s' "$username" "${KAMAL_REGISTRY_PASSWORD:-$NODE_AUTH_TOKEN}" | base64 | tr -d '\n')
  printf '{"auths":{"ghcr.io":{"auth":"%s"}}}' "$auth" >"$config/config.json"

  DOCKER_CONFIG=$config docker push --quiet "$repository:$version"
  echo "pushed $repository:$version"
fi
