{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "emittedAt": {
      "description": "When the sender emitted the message, in UTC.",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "id": {
      "description": "Unique per message, so receivers can drop duplicates.",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "kind": { "const": "bench.info", "type": "string" },
    "payload": {
      "properties": {
        "architecture": {
          "description": "The CPU architecture, such as `arm64` or `amd64`.",
          "maxLength": 50,
          "minLength": 1,
          "type": "string"
        },
        "cpu": {
          "description": "The processor.",
          "properties": {
            "cores": {
              "description": "The number of logical cores.",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "model": {
              "description": "The CPU model name.",
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": ["model", "cores"],
          "type": "object"
        },
        "daemonVersion": {
          "description": "The version of the daemon that sent this.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "hostname": {
          "description": "The bench's hostname.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "memoryTotalBytes": {
          "description": "Total physical memory, in bytes.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "os": {
          "description": "The operating system the bench runs.",
          "properties": {
            "name": {
              "description": "The operating system, such as `darwin` or `linux`.",
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "description": "The operating system version.",
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": ["name", "version"],
          "type": "object"
        }
      },
      "required": [
        "hostname",
        "os",
        "architecture",
        "cpu",
        "memoryTotalBytes",
        "daemonVersion"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "description": "The `<major>.<minor>` version of this message kind. Readers accept any `1.x`.",
      "pattern": "^1\\.(0|[1-9]\\d*)$",
      "type": "string"
    }
  },
  "required": ["schemaVersion", "kind", "id", "emittedAt", "payload"],
  "type": "object"
}
