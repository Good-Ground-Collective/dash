{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "emittedAt": {
      "description": "When the sender emitted the message, in UTC.",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "id": {
      "description": "Unique per message, so receivers can drop duplicates.",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "kind": { "const": "bench.metrics", "type": "string" },
    "payload": {
      "properties": {
        "cpuPercent": {
          "description": "CPU use across all cores, as a percentage.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "disks": {
          "description": "Disk use for each volume.",
          "items": {
            "properties": {
              "totalBytes": {
                "description": "Total space, in bytes.",
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "usedBytes": {
                "description": "Space in use, in bytes.",
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "volume": {
                "description": "The volume, such as a mount point or a drive letter.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["volume", "usedBytes", "totalBytes"],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array"
        },
        "memory": {
          "description": "Memory use.",
          "properties": {
            "totalBytes": {
              "description": "Total physical memory, in bytes.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "usedBytes": {
              "description": "Memory in use, in bytes.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": ["usedBytes", "totalBytes"],
          "type": "object"
        },
        "network": {
          "description": "Network traffic since the previous sample.",
          "properties": {
            "bytesIn": {
              "description": "Bytes received since the previous sample.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "bytesOut": {
              "description": "Bytes sent since the previous sample.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": ["bytesIn", "bytesOut"],
          "type": "object"
        },
        "sampledAt": {
          "description": "When the sample was taken, in UTC. Differs from `emittedAt` for a backfilled sample.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        }
      },
      "required": ["sampledAt", "cpuPercent", "memory", "disks", "network"],
      "type": "object"
    },
    "schemaVersion": {
      "description": "The `<major>.<minor>` version of this message kind. Readers accept any `1.x`.",
      "pattern": "^1\\.(0|[1-9]\\d*)$",
      "type": "string"
    }
  },
  "required": ["schemaVersion", "kind", "id", "emittedAt", "payload"],
  "type": "object"
}
