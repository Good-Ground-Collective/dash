{
  "name": "@good-ground-collective/agentic-communication-standards",
  "version": "0.0.0",
  "description": "Zod schemas for the messages that pass between Dash's components, with a shared envelope and versioning rules",
  "repository": {
    "type": "git",
    "url": "https://github.com/Good-Ground-Collective/dash.git",
    "directory": "packages/standards"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "imports": {
    "#src/*.js": {
      "@good-ground-collective/standards-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "#src/*.json": "./src/*.json",
    "#release/*.js": "./release/*.ts"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "node --conditions=@good-ground-collective/standards-source scripts/generate-json-schema.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@dash/config": "workspace:*",
    "@semantic-release/exec": "catalog:",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "conventional-changelog-conventionalcommits": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "semantic-release": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "standards-v${version}",
    "plugins": [
      [
        "./release/package-commits.ts",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "npm pkg set version=${nextRelease.version} && pnpm run build && pnpm pack --out package.tgz",
          "publishCmd": "npm publish package.tgz --registry https://npm.pkg.github.com"
        }
      ],
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failComment": false,
          "releasedLabels": false
        }
      ]
    ]
  }
}
