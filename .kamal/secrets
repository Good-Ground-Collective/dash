# Kamal reads every secret from the environment of whoever runs it: bin/kamal
# on a laptop, or a GitHub Actions job's secrets in CI. Never put values here.
KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
NODE_AUTH_TOKEN=$NODE_AUTH_TOKEN
BETTER_AUTH_SECRET=$DASH_BETTER_AUTH_SECRET
# dash-db accepts only TLS (hostssl), and node-postgres would otherwise connect in
# plain text. Mission Control has no CA for dash-db's certificate yet, and the link
# already runs inside Tailscale's WireGuard, so TLS here encrypts without verifying.
DATABASE_URL=${DASH_DATABASE_URL}?sslmode=no-verify
