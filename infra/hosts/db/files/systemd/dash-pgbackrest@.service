[Unit]
Description=pgBackRest %i backup of dash-db
After=postgresql@18-main.service
Requires=postgresql@18-main.service
OnFailure=dash-pgbackrest-failed@%n.service

[Service]
Type=oneshot
User=postgres
Group=postgres
# check fails if WAL archiving is broken, so a quiet archive failure surfaces
# here within a day.
ExecStartPre=/usr/bin/pgbackrest --stanza=dash check
ExecStart=/usr/bin/pgbackrest --stanza=dash --type=%i backup
ExecStartPost=/usr/bin/pgbackrest --stanza=dash info
